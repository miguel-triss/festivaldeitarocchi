---
// A strip of paper tape with torn ends, as on the moodboard collage.
interface Props {
  rotate?: number;
  width?: string;
  class?: string;
  style?: string;
}
const { rotate = -4, width = "7rem", class: cls = "", style = "" } = Astro.props;
---

<span class:list={["tape", cls]} style={`--rot:${rotate}deg;--w:${width};${style}`} aria-hidden="true"></span>

<style>
  .tape {
    position: absolute;
    z-index: 3;
    width: var(--w);
    height: calc(var(--w) * 0.3);
    transform: rotate(var(--rot));
    background:
      url("/textures/paper-grain.webp") 0 0 / 120px,
      color-mix(in oklab, var(--c-cream) 72%, transparent);
    background-blend-mode: multiply;
    box-shadow: 0 1px 2px rgb(24 27 46 / 0.18);
    clip-path: polygon(
      0% 8%, 3% 0%, 6% 10%, 9% 2%, 12% 0%, 88% 0%, 91% 6%, 94% 0%, 97% 9%, 100% 3%,
      100% 92%, 97% 100%, 94% 90%, 91% 100%, 88% 96%, 12% 100%, 9% 92%, 6% 100%, 3% 91%, 0% 97%
    );
    opacity: 0.9;
  }
</style>
