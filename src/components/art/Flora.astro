---
// A bunch of plants tucked at the edge of a section, as the infographic
// frames its panels with flowers and leaves. Each stem sways a little on its
// own clock; with motion, the bunch grows in from the ground when it appears.
// Place it with `style` (absolute position and width); it never takes pointer
// events and is hidden from assistive tech.
import { plant, type Kind } from "../../lib/flora";

type Stem = [kind: Kind, x: number, h: number, bend?: number, lean?: number];
interface Props {
  stems: Stem[];
  seed?: number;
  flip?: boolean;
  style?: string;
  class?: string;
}
const { stems, seed = 1, flip = false, style = "", class: cls = "" } = Astro.props;
// all stems stand on the bottom edge of a 300 x 320 box
const W = 300, H = 320;
---

<div class:list={["flora", cls]} style={style} aria-hidden="true" data-flora>
  <svg viewBox={`-20 0 ${W + 40} ${H}`} preserveAspectRatio="xMidYMax meet" style={flip ? "transform: scaleX(-1)" : ""}>
    {stems.map(([kind, x, h, bend = 0, lean = 0], i) => (
      <g transform={`translate(${x} ${H}) rotate(${lean})`}>
        <g class="flora-stem" style={`--d:${(5.5 + ((i * 7) % 5) * 0.6).toFixed(1)}s;--del:${(-i * 1.3).toFixed(1)}s`} set:html={plant(kind, h, bend, seed * 10 + i)} />
      </g>
    ))}
  </svg>
</div>

<style>
  .flora {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    line-height: 0;
  }
  @media (max-width: 700px) { .flora { max-width: 44vw; } }
  .flora svg { width: 100%; height: auto; overflow: visible; max-width: none; }
  .flora-stem { transform-box: fill-box; transform-origin: 50% 100%; }
  :global(.motion) .flora.is-live .flora-stem { animation: flora-sway var(--d) ease-in-out var(--del) infinite; }
  @keyframes flora-sway {
    0%, 100% { rotate: -1.8deg; }
    50% { rotate: 1.8deg; }
  }
</style>

<script>
  // sway only while visible: no animation work for plants off screen
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.target.classList.toggle("is-live", e.isIntersecting);
  }, { rootMargin: "100px" });
  document.querySelectorAll("[data-flora]").forEach((el) => io.observe(el));
</script>
