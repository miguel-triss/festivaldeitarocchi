---
// A doorway of a Dimora, seen from the room before it. Inside: the back wall
// of the room (its colour), its emblem painted in the lunette, and at the
// bottom the opening to the next room, exactly half as tall. Because every
// door holds the next one at the same place and scale, a walk through the
// rooms is a single self-similar zoom (see enfilade.ts).
import { G, C, P, T, N } from "../../lib/draw";

interface Props {
  room: string; // colour of this room
  next: string; // colour of the next opening
  emblem: "intro" | "opera" | "installazione" | "programma" | "passaporto" | "exit";
  class?: string;
  style?: string;
}
const { room, next, emblem, class: cls = "", style = "" } = Astro.props;

// emblems in a 100 x 50 lunette box
const art: Record<Props["emblem"], string> = {
  intro: `
    <path d="M30 40Q40 35 50 40V20Q40 15 30 20Z" fill="${C}"/><path d="M70 40Q60 35 50 40V20Q60 15 70 20Z" fill="${C}"/>
    <path d="M34 25H46M34 29H46M34 33H44M54 25H66M54 29H66M54 33H64" stroke="${N}" stroke-width=".6" opacity=".5"/>
    <g transform="translate(50 12) rotate(-6)"><rect x="-6" y="-10" width="12" height="20" rx="1" fill="${N}" stroke="${G}" stroke-width=".8"/><path d="M-3 8V-2A3 3 0 0 1 3 -2V8" fill="none" stroke="${G}" stroke-width=".6"/><circle cy="1" r="1.4" fill="${G}"/></g>`,
  opera: `
    <path d="M42 0H58L74 46H26Z" fill="${C}" opacity=".13"/>
    <rect x="34" y="16" width="32" height="26" fill="none" stroke="${G}" stroke-width="2.4"/>
    <rect x="38" y="20" width="24" height="18" fill="none" stroke="${G}" stroke-width=".6"/>
    <path d="M50 24.5C50.3 27.6 51 28.8 54.5 29C51 29.2 50.3 30.4 50 33.5C49.7 30.4 49 29.2 45.5 29C49 28.8 49.7 27.6 50 24.5Z" fill="${G}" opacity=".8"/>
    <circle cx="50" cy="2" r="2.2" fill="${G}"/>`,
  installazione: `
    ${[10, 17, 24].map((r) => `<path d="M${50 - r} 30A${r} ${r} 0 0 1 ${50 + r} 30" fill="none" stroke="${C}" stroke-width=".9" opacity="${1 - r / 34}"/>`).join("")}
    ${Array.from({ length: 9 }, (_, i) => `<path d="M50 30L${(50 + 40 * Math.cos(Math.PI + (i * Math.PI) / 8)).toFixed(1)} ${(30 + 40 * Math.sin(Math.PI + (i * Math.PI) / 8)).toFixed(1)}" stroke="${G}" stroke-width=".5" opacity=".7"/>`).join("")}
    <circle cx="50" cy="30" r="5" fill="${G}"/>
    <rect x="24" y="36" width="52" height="10" fill="${P}" opacity=".55"/>`,
  programma: `
    <path d="M44 20H56L54 44H46Z" fill="${C}"/><path d="M42 20H58" stroke="${G}" stroke-width="1.4"/>
    ${[-3, -2, -1, 1, 2, 3].map((k) => `<circle cx="${(50 + k * 9).toFixed(1)}" cy="${(46 - Math.abs(k) * 3.4).toFixed(1)}" r="2.6" fill="${N}" opacity=".75"/>`).join("")}
    <path d="M62 8Q70 4 76 9Q74 16 66 15L62 18L63 14Q58 11 62 8Z" fill="${C}"/>`,
  passaporto: `
    <rect x="26" y="16" width="22" height="28" rx="1.5" fill="${T}"/><path d="M31 22H43" stroke="${C}" stroke-width=".7"/>
    <circle cx="62" cy="28" r="13" fill="none" stroke="${C}" stroke-width="1.8"/><circle cx="62" cy="28" r="9" fill="none" stroke="${C}" stroke-width=".6"/>
    <path d="M62 21C62.4 25.5 63.4 27.4 69 28C63.4 28.6 62.4 30.5 62 35C61.6 30.5 60.6 28.6 55 28C60.6 27.4 61.6 25.5 62 21Z" fill="${G}"/>`,
  exit: `
    <path d="M50 8C51 22 54 27 68 28C54 29 51 34 50 48C49 34 46 29 32 28C46 27 49 22 50 8Z" fill="${C}" opacity=".9"/>`,
};
---

<div class:list={["door", `door--${emblem}`, cls]} style={`--room:${room};--next:${next};${style}`} aria-hidden="true">
  <svg class="door-lunette" viewBox="0 0 100 50" set:html={art[emblem]} />
  {emblem !== "exit" && <span class="door-next"></span>}
</div>

<style>
  .door {
    position: relative;
    aspect-ratio: 1 / 1.45;
    border-radius: 999px 999px 0 0;
    background:
      radial-gradient(ellipse 70% 40% at 50% 100%, color-mix(in oklab, var(--c-night-deep) 35%, transparent), transparent),
      var(--room);
    box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--c-gold) 85%, transparent);
    overflow: hidden;
    contain: paint;
  }
  .door--exit {
    background: radial-gradient(circle at 50% 70%, var(--c-cream), var(--c-gold) 60%);
  }
  .door-lunette {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 16%;
    width: 72%;
    height: auto;
  }
  /* the opening to the next room: same shape, half the height, on the floor */
  .door-next {
    position: absolute;
    left: 25%;
    width: 50%;
    bottom: 0;
    aspect-ratio: 1 / 1.45;
    border-radius: 999px 999px 0 0;
    background: var(--next);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c-gold) 85%, transparent);
  }
</style>
