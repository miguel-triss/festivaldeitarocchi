---
// The guiding star. Desktop with a fine pointer and motion allowed only.
//  - a small four-point star follows the pointer; magenta on the paper of the
//    day, gold at dusk and at night (it reads the scene under the pointer)
//  - moving leaves a short trail of stardust that drifts down and fades;
//    at night the dust glows, like the lanterns
//  - over links and buttons the star turns and a small arch opens around it
//  - a click scatters a few sparks, like a stamp being pressed
// Text fields keep the system caret so you always see where you type.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor-arch"></span>
  <svg class="cursor-star" viewBox="0 0 100 100">
    <path d="M50 0C51.6 36 58 45.5 100 50C58 54.5 51.6 64 50 100C48.4 64 42 54.5 0 50C42 45.5 48.4 36 50 0Z" />
  </svg>
</div>
<canvas class="cursor-dust" aria-hidden="true"></canvas>

<style>
  .cursor {
    --cur: var(--c-magenta);
    --edge: var(--c-cream);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 300;
    width: 0;
    height: 0;
    pointer-events: none;
    display: none;
    transition: opacity var(--dur-fast);
  }
  .cursor.is-night { --cur: var(--c-gold); --edge: var(--c-night-deep); }
  .cursor-dust {
    position: fixed;
    inset: 0;
    z-index: 299;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    display: none;
  }
  :global(html.has-cursor) .cursor, :global(html.has-cursor) .cursor-dust { display: block; }
  :global(html.has-cursor), :global(html.has-cursor *) { cursor: none; }
  :global(html.has-cursor) :is(input:not([type="checkbox"]):not([type="radio"]), textarea, select) { cursor: auto; }

  .cursor-star {
    position: absolute;
    width: 22px;
    height: 22px;
    max-width: none; /* the container is 0 wide on purpose */
    translate: -50% -50%;
    fill: var(--cur);
    stroke: var(--edge);
    stroke-width: 9; /* an outline of the opposite tone: visible on any fill */
    paint-order: stroke;
    filter: drop-shadow(0 0 0 transparent);
    transition: scale var(--dur-fast) var(--ease-out), rotate var(--dur-base) var(--ease-out), fill var(--dur-base);
  }
  .cursor.is-night .cursor-star { filter: drop-shadow(0 0 6px color-mix(in oklab, var(--c-gold) 70%, transparent)); }
  /* the small arch that opens around the star over something clickable */
  .cursor-arch {
    position: absolute;
    width: 38px;
    height: 50px;
    translate: -50% -58%;
    border: 1.5px solid var(--cur);
    border-bottom: 0;
    filter: drop-shadow(0 0 1px var(--edge)) drop-shadow(0 0 1px var(--edge));
    border-radius: 999px 999px 0 0;
    scale: 0.3;
    opacity: 0;
    transition: scale var(--dur-base) var(--ease-out), opacity var(--dur-fast), border-color var(--dur-base);
  }
  .cursor.is-link .cursor-star { rotate: 45deg; scale: 0.62; }
  .cursor.is-link .cursor-arch { scale: 1; opacity: 1; }
  .cursor.is-down .cursor-star { scale: 0.5; }
  .cursor.is-out { opacity: 0; }
</style>

<script>
  import { gsap, reduced, finePointer } from "../scripts/motion";

  if (finePointer && !reduced) {
    const el = document.querySelector<HTMLElement>(".cursor")!;
    const canvas = document.querySelector<HTMLCanvasElement>(".cursor-dust")!;
    const ctx = canvas.getContext("2d")!;
    document.documentElement.classList.add("has-cursor");

    const x = gsap.quickTo(el, "x", { duration: 0.25, ease: "power3.out" });
    const y = gsap.quickTo(el, "y", { duration: 0.25, ease: "power3.out" });
    const interactive = "a, button, [role='button'], summary, label, [data-magnetic]";
    const css = getComputedStyle(document.documentElement);
    const colors = {
      day: css.getPropertyValue("--c-magenta").trim(),
      night: css.getPropertyValue("--c-gold").trim(),
    };

    // ---- stardust -------------------------------------------------------
    type Dust = { x: number; y: number; vx: number; vy: number; life: number; r: number; spark: boolean };
    const dust: Dust[] = [];
    let night = false;
    let running = false;
    let last = performance.now();
    let px = -1, py = -1;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    const spawn = (cx: number, cy: number, n: number, burst = false) => {
      for (let i = 0; i < n && dust.length < 90; i++) {
        const a = Math.random() * Math.PI * 2;
        const s = burst ? 1.2 + Math.random() * 2.2 : Math.random() * 0.35;
        dust.push({
          x: cx + (burst ? 0 : (Math.random() - 0.5) * 6),
          y: cy + (burst ? 0 : (Math.random() - 0.5) * 6),
          vx: Math.cos(a) * s,
          vy: Math.sin(a) * s + (burst ? -0.4 : 0.15),
          life: 1,
          r: burst ? 2.2 + Math.random() * 2 : 1 + Math.random() * 1.8,
          spark: Math.random() < (burst ? 0.8 : 0.35),
        });
      }
      if (!running) { running = true; last = performance.now(); requestAnimationFrame(tick); }
    };

    const sparkle = (cx: number, cy: number, r: number) => {
      ctx.beginPath();
      ctx.moveTo(cx, cy - r * 2.2);
      ctx.quadraticCurveTo(cx + r * 0.25, cy - r * 0.25, cx + r * 2.2, cy);
      ctx.quadraticCurveTo(cx + r * 0.25, cy + r * 0.25, cx, cy + r * 2.2);
      ctx.quadraticCurveTo(cx - r * 0.25, cy + r * 0.25, cx - r * 2.2, cy);
      ctx.quadraticCurveTo(cx - r * 0.25, cy - r * 0.25, cx, cy - r * 2.2);
      ctx.fill();
    };

    function tick(now: number) {
      const dt = Math.min(48, now - last);
      last = now;
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      ctx.globalCompositeOperation = night ? "lighter" : "source-over";
      ctx.fillStyle = night ? colors.night : colors.day;
      ctx.shadowColor = night ? colors.night : "transparent";
      ctx.shadowBlur = night ? 8 : 0;
      for (let i = dust.length - 1; i >= 0; i--) {
        const d = dust[i];
        d.life -= dt / 760;
        if (d.life <= 0) { dust.splice(i, 1); continue; }
        d.vx *= 0.96;
        d.vy = d.vy * 0.96 + 0.018; // drifts down, like glitter
        d.x += d.vx * (dt / 16);
        d.y += d.vy * (dt / 16);
        ctx.globalAlpha = Math.min(1, d.life * 1.4);
        const r = d.r * (0.4 + d.life * 0.6);
        if (d.spark) sparkle(d.x, d.y, r);
        else { ctx.beginPath(); ctx.arc(d.x, d.y, r * 0.7, 0, Math.PI * 2); ctx.fill(); }
      }
      ctx.globalAlpha = 1;
      if (dust.length) requestAnimationFrame(tick);
      else { running = false; ctx.clearRect(0, 0, innerWidth, innerHeight); }
    }

    // ---- pointer ----------------------------------------------------------
    let pending = false;
    let target: Element | null = null;
    const readScene = () => {
      pending = false;
      if (!target) return;
      const scene = (target.closest("[data-scene]") as HTMLElement | null)?.dataset.scene;
      night = scene === "night" || scene === "dusk";
      el.classList.toggle("is-night", night);
      el.classList.toggle("is-link", !!target.closest(interactive));
    };

    window.addEventListener("pointermove", (e) => {
      x(e.clientX); y(e.clientY);
      el.classList.remove("is-out");
      target = e.target as Element;
      if (!pending) { pending = true; requestAnimationFrame(readScene); }
      // a grain of dust every few pixels travelled
      const dx = e.clientX - px, dy = e.clientY - py;
      if (px < 0 || dx * dx + dy * dy > 64) {
        if (px >= 0) spawn(e.clientX, e.clientY, 1 + (Math.random() < 0.4 ? 1 : 0));
        px = e.clientX; py = e.clientY;
      }
    }, { passive: true });
    document.documentElement.addEventListener("mouseleave", () => el.classList.add("is-out"));
    window.addEventListener("pointerdown", (e) => { el.classList.add("is-down"); spawn(e.clientX, e.clientY, 12, true); });
    window.addEventListener("pointerup", () => el.classList.remove("is-down"));

    // magnetic: the element leans a third of the way towards the pointer
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((m) => {
      const mx = gsap.quickTo(m, "x", { duration: 0.5, ease: "power3.out" });
      const my = gsap.quickTo(m, "y", { duration: 0.5, ease: "power3.out" });
      m.addEventListener("pointermove", (e) => {
        const r = m.getBoundingClientRect();
        mx((e.clientX - (r.left + r.width / 2)) * 0.3);
        my((e.clientY - (r.top + r.height / 2)) * 0.35);
      });
      m.addEventListener("pointerleave", () => {
        gsap.to(m, { x: 0, y: 0, duration: 0.9, ease: "elastic.out(1, 0.45)", overwrite: true });
      });
    });
  }
</script>
