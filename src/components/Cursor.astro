---
// The guiding star. Desktop with a fine pointer and motion allowed only.
//  - a small four-point star follows the pointer; magenta on the paper of the
//    day, gold at dusk and at night (it reads the scene under the pointer)
//  - moving leaves a short trail of stardust that drifts down and fades;
//    at night the dust glows, like the lanterns
//  - over links and buttons the star turns and a small arch opens around it
//  - a click scatters a few sparks, like a stamp being pressed
// Text fields keep the system caret so you always see where you type.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor-arch"></span>
  <svg class="cursor-star" viewBox="0 0 100 100">
    <path d="M50 0C51.6 36 58 45.5 100 50C58 54.5 51.6 64 50 100C48.4 64 42 54.5 0 50C42 45.5 48.4 36 50 0Z" />
  </svg>
</div>
<canvas class="cursor-dust" aria-hidden="true"></canvas>

<style>
  .cursor {
    --cur: var(--c-magenta);
    --edge: var(--c-cream);
    position: fixed;
    left: 0;
    top: 0;
    z-index: 300;
    width: 0;
    height: 0;
    pointer-events: none;
    display: none;
    will-change: transform;
    transition: opacity var(--dur-fast);
  }
  .cursor.is-night { --cur: var(--c-gold); --edge: var(--c-night-deep); }
  .cursor-dust {
    position: fixed;
    inset: 0;
    z-index: 299;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    display: none;
  }
  :global(html.has-cursor) .cursor, :global(html.has-cursor) .cursor-dust { display: block; }
  :global(html.has-cursor), :global(html.has-cursor *) { cursor: none; }
  :global(html.has-cursor) :is(input:not([type="checkbox"]):not([type="radio"]), textarea, select) { cursor: auto; }

  .cursor-star {
    position: absolute;
    width: 22px;
    height: 22px;
    max-width: none; /* the container is 0 wide on purpose */
    translate: -50% -50%;
    fill: var(--cur);
    stroke: var(--edge);
    stroke-width: 9; /* an outline of the opposite tone: visible on any fill */
    paint-order: stroke;
    filter: drop-shadow(0 0 0 transparent);
    transition: scale var(--dur-fast) var(--ease-out), rotate var(--dur-base) var(--ease-out), fill var(--dur-base);
  }
  .cursor.is-night .cursor-star { filter: drop-shadow(0 0 6px color-mix(in oklab, var(--c-gold) 70%, transparent)); }
  /* the small arch that opens around the star over something clickable */
  .cursor-arch {
    position: absolute;
    width: 38px;
    height: 50px;
    translate: -50% -58%;
    border: 1.5px solid var(--cur);
    border-bottom: 0;
    filter: drop-shadow(0 0 1px var(--edge)) drop-shadow(0 0 1px var(--edge));
    border-radius: 999px 999px 0 0;
    scale: 0.3;
    opacity: 0;
    transition: scale var(--dur-base) var(--ease-out), opacity var(--dur-fast), border-color var(--dur-base);
  }
  .cursor.is-link .cursor-star { rotate: 45deg; scale: 0.62; }
  .cursor.is-link .cursor-arch { scale: 1; opacity: 1; }
  .cursor.is-down .cursor-star { scale: 0.5; }
  .cursor.is-out { opacity: 0; }
</style>

<script>
  import { gsap, reduced, finePointer } from "../scripts/motion";

  if (finePointer && !reduced) {
    const el = document.querySelector<HTMLElement>(".cursor")!;
    const canvas = document.querySelector<HTMLCanvasElement>(".cursor-dust")!;
    const ctx = canvas.getContext("2d")!;
    document.documentElement.classList.add("has-cursor");
    const interactive = "a, button, [role='button'], summary, label, [data-magnetic]";
    const css = getComputedStyle(document.documentElement);
    const DAY = css.getPropertyValue("--c-magenta").trim();
    const NIGHT = css.getPropertyValue("--c-gold").trim();

    // ---- one loop for everything: eased position + stardust ----------------
    // The star eases towards the pointer every frame (no separate x/y tweens
    // fighting each other); dust is drawn from pre-rendered sprites (no
    // per-frame blur), and the loop sleeps when there is nothing to do.
    let tx = -100, ty = -100, cx = -100, cy = -100;
    let night = false, awake = false, last = performance.now();

    const sprite = (color: string, glow: boolean, spark: boolean) => {
      const S = 48, c = document.createElement("canvas");
      c.width = c.height = S;
      const g = c.getContext("2d")!;
      if (glow) {
        const rg = g.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
        rg.addColorStop(0, color); rg.addColorStop(0.25, color + "88"); rg.addColorStop(1, color + "00");
        g.fillStyle = rg; g.fillRect(0, 0, S, S);
      }
      g.fillStyle = color;
      const m = S / 2, r = spark ? 9 : 4.5;
      g.beginPath();
      if (spark) {
        g.moveTo(m, m - r * 2);
        g.quadraticCurveTo(m + r * 0.22, m - r * 0.22, m + r * 2, m);
        g.quadraticCurveTo(m + r * 0.22, m + r * 0.22, m, m + r * 2);
        g.quadraticCurveTo(m - r * 0.22, m + r * 0.22, m - r * 2, m);
        g.quadraticCurveTo(m - r * 0.22, m - r * 0.22, m, m - r * 2);
      } else g.arc(m, m, r, 0, Math.PI * 2);
      g.fill();
      return c;
    };
    const sprites = {
      day: [sprite(DAY, false, false), sprite(DAY, false, true)],
      night: [sprite(NIGHT, true, false), sprite(NIGHT, true, true)],
    };

    type Dust = { x: number; y: number; vx: number; vy: number; life: number; s: number; spark: boolean; night: boolean };
    const dust: Dust[] = [];

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(innerWidth * dpr);
      canvas.height = Math.round(innerHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener("resize", resize);

    const wake = () => { if (!awake) { awake = true; last = performance.now(); requestAnimationFrame(frame); } };

    function frame(now: number) {
      const dt = Math.min(40, now - last);
      last = now;
      // eased follow: frame-rate independent
      const k = 1 - Math.pow(0.001, dt / 1000 * 3.2);
      cx += (tx - cx) * k;
      cy += (ty - cy) * k;
      el.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;

      if (dust.length) ctx.clearRect(0, 0, innerWidth, innerHeight);
      for (let i = dust.length - 1; i >= 0; i--) {
        const d = dust[i];
        d.life -= dt / 800;
        if (d.life <= 0) { dust.splice(i, 1); continue; }
        d.vx *= 0.955;
        d.vy = d.vy * 0.955 + 0.02; // drifts down, like glitter
        d.x += d.vx * (dt / 16);
        d.y += d.vy * (dt / 16);
        const img = (d.night ? sprites.night : sprites.day)[d.spark ? 1 : 0];
        const size = d.s * (0.45 + d.life * 0.55);
        ctx.globalAlpha = Math.min(1, d.life * 1.5);
        ctx.drawImage(img, d.x - size / 2, d.y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
      if (!dust.length) ctx.clearRect(0, 0, innerWidth, innerHeight);

      const settled = Math.abs(tx - cx) < 0.1 && Math.abs(ty - cy) < 0.1;
      if (dust.length || !settled) requestAnimationFrame(frame);
      else awake = false;
    }

    const spawn = (x: number, y: number, n: number, burst = false) => {
      for (let i = 0; i < n && dust.length < 80; i++) {
        const a = Math.random() * Math.PI * 2;
        const sp = burst ? 1.3 + Math.random() * 2.2 : Math.random() * 0.3;
        dust.push({
          x: x + (burst ? 0 : (Math.random() - 0.5) * 6),
          y: y + (burst ? 0 : (Math.random() - 0.5) * 6),
          vx: Math.cos(a) * sp,
          vy: Math.sin(a) * sp + (burst ? -0.4 : 0.12),
          life: 1,
          s: (burst ? 20 : 12) + Math.random() * (night ? 14 : 8),
          spark: Math.random() < (burst ? 0.8 : 0.35),
          night,
        });
      }
      wake();
    };

    // ---- pointer ----------------------------------------------------------
    let target: Element | null = null, pending = false, px = -1, py = -1;
    const readScene = () => {
      pending = false;
      if (!target) return;
      const scene = (target.closest("[data-scene]") as HTMLElement | null)?.dataset.scene;
      night = scene === "night" || scene === "dusk";
      el.classList.toggle("is-night", night);
      el.classList.toggle("is-link", !!target.closest(interactive));
    };
    window.addEventListener("pointermove", (e) => {
      if (tx < -50) { cx = e.clientX; cy = e.clientY; } // first move: no fly-in from the corner
      tx = e.clientX; ty = e.clientY;
      el.classList.remove("is-out");
      target = e.target as Element;
      if (!pending) { pending = true; requestAnimationFrame(readScene); }
      const dx = tx - px, dy = ty - py;
      if (px < 0 || dx * dx + dy * dy > 81) {
        if (px >= 0) spawn(tx, ty, Math.random() < 0.45 ? 2 : 1);
        px = tx; py = ty;
      }
      wake();
    }, { passive: true });
    document.documentElement.addEventListener("mouseleave", () => el.classList.add("is-out"));
    window.addEventListener("pointerdown", (e) => { el.classList.add("is-down"); spawn(e.clientX, e.clientY, 12, true); });
    window.addEventListener("pointerup", () => el.classList.remove("is-down"));

    // magnetic: the element leans a third of the way towards the pointer
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((m) => {
      const mx = gsap.quickTo(m, "x", { duration: 0.5, ease: "power3.out" });
      const my = gsap.quickTo(m, "y", { duration: 0.5, ease: "power3.out" });
      m.addEventListener("pointermove", (e) => {
        const r = m.getBoundingClientRect();
        mx((e.clientX - (r.left + r.width / 2)) * 0.3);
        my((e.clientY - (r.top + r.height / 2)) * 0.35);
      });
      m.addEventListener("pointerleave", () => {
        gsap.to(m, { x: 0, y: 0, duration: 0.9, ease: "elastic.out(1, 0.45)", overwrite: true });
      });
    });
  }
</script>
