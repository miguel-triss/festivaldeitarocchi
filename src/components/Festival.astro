---
// III · Il Festival in breve. The moodboard's wooden signposts become the way
// in: a pole with four signs (Hub, Dimore, Passaporto, Notte) stays beside
// the text on desktop and swings to the part you are reading. On phones each
// part opens with its own sign. Rose paper: late morning of the festival day.
import Card from "./art/Card.astro";
import Stamp from "./art/Stamp.astro";
import Star from "./art/Star.astro";
import Moon from "./art/Moon.astro";
import Sun from "./art/Sun.astro";
import Tape from "./art/Tape.astro";
import Print from "./art/Print.astro";
// trial image cropped from design/moodboard.jpg: replace with a real photo
import stendardiMuro from "../assets/photos/moodboard-stendardi-muro.png";
import Flora from "./art/Flora.astro";

const parts = [
  { id: "hub", sign: "Hub Principale", tone: "violet", dir: "r" },
  { id: "dimore-breve", sign: "Le Dimore", tone: "magenta", dir: "l" },
  { id: "passaporto", sign: "Passaporto", tone: "gold", dir: "r" },
  { id: "notte-breve", sign: "Notte degli Arcani", tone: "night", dir: "l" },
];
const hub = ["informazioni", "Passaporto degli Arcani", "bookshop", "pubblicazioni", "partner", "parte del programma comune"];
// stamps pressed in an order that is not the page order: the visitor chooses
const stamps = [
  { symbol: "sun", numeral: "XIX", ink: "var(--c-magenta)", r: -9, order: 2 },
  { symbol: "moon", numeral: "XVIII", ink: "var(--c-violet)", r: 7, order: 0 },
  { symbol: "star", numeral: "XVII", ink: "var(--c-green)", r: -4, order: 3 },
  { symbol: "eye", numeral: "II", ink: "var(--c-terra)", r: 11, order: 1 },
  { symbol: "arch", numeral: "", ink: "", r: 0, order: -1 },
  { symbol: "star", numeral: "", ink: "", r: 0, order: -1 },
] as const;
---

<section class="section festival" id="festival" data-scene="rose" aria-labelledby="h-festival">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-num" aria-hidden="true">03</span>
      <h2 class="sec-title" id="h-festival">Il Festival in breve</h2>
    </header>

    <div class="festival-top">
      <p class="statement festival-statement" data-split>
        Tre giorni alla Fabbrica del Vapore, intorno a un <em>Hub Principale</em> e alle <em>Dimore degli Arcani.</em>
      </p>
      <Print src={stendardiMuro} alt="Stendardi dipinti con soli e lune appesi a un muro di pietra" rotate={3} speed={0.3} class="festival-print" />
      <div class="festival-days" aria-hidden="true" data-rise>
        <span class="day"><span class="day-sun"><Sun /></span></span>
        <span class="day"><span class="day-sun"><Sun /></span></span>
        <span class="day day--night"><span class="day-moon"><Moon lit={0.28} size="100%" rotate={-20} color="var(--c-gold)" /></span></span>
      </div>
    </div>

    <div class="festival-way">
      <nav class="signpost" aria-label="Le parti del Festival" data-signpost>
        <span class="signpost-top" aria-hidden="true"><Star size="1.6rem" color="var(--c-gold)" /></span>
        <span class="signpost-pole" aria-hidden="true"></span>
        {parts.map((p) => (
          <a class:list={["sign", `sign--${p.tone}`, `sign--${p.dir}`]} href={`#${p.id}`} data-sign={p.id}>{p.sign}</a>
        ))}
        <span class="signpost-foot" aria-hidden="true"></span>
      </nav>

      <div class="festival-parts">
        <article class="part" id="hub" data-part="hub">
          <h3 class="part-sign sign sign--violet sign--r">Hub Principale</h3>
          <p class="part-lead">Il punto di ingresso e orientamento.</p>
          <p>Qui il pubblico trova:</p>
          <ul class="hub-tags" role="list">
            {hub.map((h, i) => <li style={`--r:${[-3, 2, -1, 3, -2, 1][i]}deg`}>{h}</li>)}
          </ul>
        </article>

        <article class="part" id="dimore-breve" data-part="dimore-breve">
          <h3 class="part-sign sign sign--magenta sign--l">Le Dimore</h3>
          <p class="part-lead">Il nucleo artistico del Festival.</p>
          <p>
            Ogni Dimora è dedicata a uno dei ventidue Arcani Maggiori e ospita un'opera d'arte contemporanea originale, un
            progetto installativo e attività collegate.
          </p>
          <div class="dimore-fan" aria-hidden="true">
            <Card n={2} style="--r:-9deg;--x:-58%" />
            <Card n={17} style="--r:0deg;--x:0%" />
            <Card n={9} style="--r:9deg;--x:58%" />
          </div>
          <p class="dimore-note">
            La configurazione completa prevede ventidue Dimore. Le prime edizioni partiranno da{" "}
            <strong>un numero selezionato di Dimore</strong>, per poi aumentare progressivamente.
          </p>
        </article>

        <article class="part" id="passaporto" data-part="passaporto">
          <h3 class="part-sign sign sign--gold sign--r">Passaporto degli Arcani</h3>
          <p class="part-lead">Accompagna il pubblico durante la visita.</p>
          <p>
            Ogni Dimora lascia un segno sul Passaporto e ciascun visitatore decide autonomamente l'ordine delle proprie
            tappe.
          </p>
          <div class="booklet" aria-hidden="true" data-booklet>
            <Tape rotate={-6} width="4.5rem" style="top:-0.9rem;left:10%" />
            <div class="booklet-page booklet-page--cover">
              <Star size="1.8rem" color="var(--c-gold)" />
              <span class="booklet-title">Passaporto<br />degli Arcani</span>
              <span class="booklet-sub">Festival dei Tarocchi</span>
            </div>
            <div class="booklet-page booklet-page--stamps">
              {stamps.map((s) => (
                <span class="slot" data-order={s.order}>
                  {s.order >= 0 && <Stamp symbol={s.symbol} numeral={s.numeral} ink={s.ink} rotate={s.r} size="100%" label="Dimora" />}
                </span>
              ))}
            </div>
          </div>
        </article>

        <article class="part part--night" id="notte-breve" data-part="notte-breve">
          <h3 class="part-sign sign sign--night sign--l">Notte degli Arcani</h3>
          <div class="night-card" data-scene="night">
            <div class="night-sky" aria-hidden="true">
              <Moon lit={0.3} size="3.2rem" rotate={-24} color="var(--c-gold)" />
              <svg class="night-lanterns" viewBox="0 0 300 60" preserveAspectRatio="none">
                <path d="M0 10Q150 70 300 10" fill="none" stroke="var(--c-cream)" stroke-width=".8" opacity=".5" />
                {Array.from({ length: 13 }, (_, i) => {
                  const t = (i + 0.5) / 13, x = t * 300, y = 10 + 60 * t * (1 - t) * 2 * 0.98;
                  return <circle class="lantern" cx={x.toFixed(1)} cy={(y + 5).toFixed(1)} r="3.2" fill="var(--c-gold)" />;
                })}
              </svg>
            </div>
            <p class="part-lead">La domenica sera.</p>
            <p>Interventi performativi nelle diverse Dimore e la chiusura finale nell'Hub.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
  <Flora seed={4} flip stems={[["spiga", 70, 240, 10, -4], ["secco", 130, 190, -8], ["spiga", 190, 210, -14, 8], ["ramo", 250, 170, -20, 14]]} style="right:0;bottom:-3rem;width:clamp(13.6rem, 25.6vw, 25.5rem)" />
</section>

<style>
  .festival { padding-block: var(--section-dense); }
  .festival-top {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: end;
    gap: var(--s-7);
    margin-bottom: var(--section-dense);
  }
  .festival-statement { max-width: 22ch; }
  .festival-top :global(.festival-print) { width: clamp(13rem, 20vw, 19rem); align-self: start; margin-top: calc(-1 * var(--s-6)); }
  .festival-days { display: flex; gap: var(--s-4); align-items: center; padding-bottom: var(--s-3); }
  .day {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 6vw, 5rem);
    aspect-ratio: 5 / 6;
    border-radius: var(--arch);
    background: var(--c-cream);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--c-night) 18%, transparent);
    overflow: hidden;
  }
  .day-sun { width: 88%; margin-top: 18%; }
  .day--night { background: var(--c-night-deep); }
  .day-moon { width: 52%; margin-top: 12%; display: block; }
  .day-moon :global(svg) { width: 100%; height: auto; }

  /* ---- signs, shared by the signpost and the mobile headings ---- */
  .sign {
    --sign-bg: var(--c-violet);
    --sign-fg: var(--c-cream);
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.55em 2.2em 0.45em 1.1em;
    background:
      url("/textures/paper-grain.webp") 0 0 / 160px,
      var(--sign-bg);
    background-blend-mode: soft-light;
    color: var(--sign-fg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.1;
    white-space: nowrap;
    clip-path: polygon(0 0, calc(100% - 1.1rem) 0, 100% 50%, calc(100% - 1.1rem) 100%, 0 100%);
    box-shadow: 0 3px 0 rgb(24 27 46 / 0.12);
  }
  .sign--l {
    padding: 0.55em 1.1em 0.45em 2.2em;
    clip-path: polygon(1.1rem 0, 100% 0, 100% 100%, 1.1rem 100%, 0 50%);
  }
  .sign--violet { --sign-bg: var(--c-violet); }
  .sign--magenta { --sign-bg: var(--c-magenta); }
  .sign--gold { --sign-bg: var(--c-gold); --sign-fg: var(--c-night-deep); }
  .sign--night { --sign-bg: var(--c-night-deep); }

  /* ---- the way: signpost + parts ---- */
  .festival-way {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) 8fr;
    gap: var(--s-8);
    align-items: start;
  }
  .signpost {
    position: sticky;
    top: calc(var(--nav-h) + var(--s-7));
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    padding-block: var(--s-2) 0;
    width: 100%;
  }
  .signpost-pole {
    position: absolute;
    top: 1.2rem;
    bottom: -3rem;
    left: 50%;
    width: 12px;
    translate: -50% 0;
    background:
      url("/textures/paper-grain.webp") 0 0 / 120px,
      color-mix(in oklab, var(--c-terra) 80%, var(--c-night));
    background-blend-mode: soft-light;
    border-radius: 3px;
  }
  .signpost-top { position: relative; z-index: 1; }
  .signpost-foot {
    position: absolute;
    bottom: -3.4rem;
    left: 50%;
    width: 4.5rem;
    height: 0.9rem;
    translate: -50% 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--c-green) 70%, transparent);
  }
  .signpost .sign {
    position: relative;
    z-index: 1;
    transform-origin: 50% 0;
    transition: rotate var(--dur-base) var(--ease-out), filter var(--dur-base), translate var(--dur-base) var(--ease-out), scale var(--dur-base) var(--ease-out);
  }
  /* nailed to the pole: right signs start at it, left signs end at it */
  .signpost .sign--r { justify-self: start; margin-left: calc(50% - 8px); }
  .signpost .sign--l { justify-self: end; margin-right: calc(50% - 8px); }
  :global(.js) .signpost .sign:not(.is-active) { filter: saturate(0.45) brightness(1.12); rotate: -2deg; }
  :global(.js) .signpost .sign--l:not(.is-active) { rotate: 2deg; }
  .signpost .sign.is-active { scale: 1.08; }
  .signpost .sign:hover { filter: none; }

  .festival-parts { display: grid; gap: var(--section-dense); }
  .part { min-height: 62svh; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: var(--s-4); }
  .part > p { max-width: 36rem; }
  .part-sign { display: none; justify-self: start; }
  .part-lead { font-family: var(--font-display); font-size: var(--fs-h3); line-height: 1.1; }

  .hub-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-3); max-width: 36rem; }
  .hub-tags li {
    padding: 0.5em 1em;
    background: var(--c-paper);
    font-family: var(--font-display);
    font-size: var(--step-1);
    rotate: var(--r);
    box-shadow: 0 6px 16px rgb(24 27 46 / 0.08);
  }

  .dimore-fan { position: relative; height: clamp(15rem, 26vw, 21rem); margin-block: var(--s-5); }
  .dimore-fan :global(.card) {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(8.5rem, 13vw, 11rem);
    translate: calc(-50% + var(--x)) 0;
    rotate: var(--r);
    transform-origin: 50% 110%;
  }
  .dimore-note { padding: var(--s-4) var(--s-5); border-left: 2px solid var(--c-magenta); background: color-mix(in oklab, var(--c-cream) 55%, transparent); }
  .dimore-note strong { font-weight: 600; }

  .booklet {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    max-width: 30rem;
    aspect-ratio: 3 / 2;
    align-items: stretch;
    margin-top: var(--s-5);
    rotate: -1.5deg;
    box-shadow: 0 18px 36px rgb(24 27 46 / 0.18);
  }
  .booklet-page { min-height: 100%; padding: var(--s-5); min-width: 0; }
  .booklet-page--cover {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
    background:
      url("/textures/paper-grain.webp") 0 0 / 180px,
      var(--c-violet);
    background-blend-mode: soft-light;
    color: var(--c-cream);
    border-radius: 6px 0 0 6px;
  }
  .booklet-title { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.05; }
  .booklet-sub { font-family: var(--font-display); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-pink); }
  .booklet-page--stamps {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-3);
    align-content: center;
    background: var(--c-paper);
    border-radius: 0 6px 6px 0;
    box-shadow: inset 12px 0 18px -14px rgb(24 27 46 / 0.35);
  }
  .slot { aspect-ratio: 1; border: 1px dashed color-mix(in oklab, var(--c-night) 30%, transparent); border-radius: 50%; display: grid; place-items: center; }
  .slot:has(.stamp) { border-color: transparent; }
  .slot :global(.stamp) { width: 108%; }

  .night-card {
    position: relative;
    padding: var(--s-7) var(--s-6) var(--s-6);
    border-radius: 12rem 12rem 0.5rem 0.5rem;
    background: var(--c-night-deep);
    color: var(--c-cream);
    overflow: hidden;
    max-width: 34rem;
  }
  .night-sky { display: grid; justify-items: center; gap: var(--s-4); margin-bottom: var(--s-5); }
  .night-lanterns { width: 100%; height: 3.5rem; overflow: visible; }
  :global(.motion) .lantern { animation: flicker 3.4s ease-in-out infinite; }
  .lantern:nth-child(3n) { animation-delay: -1.2s; }
  .lantern:nth-child(3n + 1) { animation-delay: -2.3s; }
  @keyframes flicker { 0%, 100% { opacity: 1; } 45% { opacity: 0.55; } 60% { opacity: 0.9; } }
  .night-card .part-lead { color: var(--c-gold); }

  @media (max-width: 900px) {
    .festival-top { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
    .festival-top :global(.festival-print) { width: 70%; margin: var(--s-4) 0 0 auto; }
    .festival-way { grid-template-columns: minmax(0, 1fr); }
    .signpost { display: none; }
    .part { min-height: 0; }
    .part-sign { display: inline-flex; font-size: 0.8rem; }
    .booklet { max-width: none; }
    .booklet-page { padding: var(--s-4); }
  }
</style>
