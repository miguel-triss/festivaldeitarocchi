---
// Hero: night outside, dawn inside the arch. The sun rises to the centre of
// the arch, a medallion with halo and rings (as the suns of the design files).
// Scrolling walks you into the sun and through the arch, into the day.
// Without JS or with reduced motion: the final composition, static.
import Sun from "./art/Sun.astro";
import Moon from "./art/Moon.astro";
import Star from "./art/Star.astro";
import Arch from "./art/Arch.astro";
import Wordmark from "./art/Wordmark.astro";
import TornEdge from "./art/TornEdge.astro";
import Flora from "./art/Flora.astro";
import { mailto } from "../data/sections";

// hand-placed sky: [x%, y%, size rem, twinkle delay s]
const sky: [number, number, number, number][] = [
  [5, 14, 0.9, 0.2], [11, 46, 0.55, 1.6], [17, 26, 1.2, 0.8], [8, 78, 0.7, 2.4], [24, 64, 0.5, 1.1],
  [29, 9, 0.6, 3.1], [33, 38, 0.45, 0.4], [69, 11, 0.8, 2.2], [74, 34, 0.5, 0.9], [81, 21, 1.1, 1.8],
  [90, 52, 0.7, 0.3], [95, 13, 0.55, 2.7], [86, 76, 0.6, 1.3], [77, 58, 0.45, 3.4], [62, 6, 0.5, 1.9],
  [40, 16, 0.4, 2.9], [55, 20, 0.45, 0.6], [3, 58, 0.5, 3.6], [97, 88, 0.6, 1.0], [20, 92, 0.5, 2.1],
];
---

<section class="hero" id="top" data-scene="night" aria-labelledby="hero-title">
  <div class="hero-sky" aria-hidden="true">
    {sky.map(([x, y, s, d]) => (
      <span class="hero-star" style={`left:${x}%;top:${y}%;--d:${d}s`}><Star size={`${s}rem`} /></span>
    ))}
    <div class="hero-dust"></div>
  </div>

  <div class="hero-stage" aria-hidden="true">
    <span class="hero-crescent hero-crescent--l" data-intro><Moon lit={0.24} size="100%" rotate={-18} waning /></span>

    <div class="hero-portal">
      <div class="hero-window" data-intro>
        <div class="hero-halo"></div>
        <svg class="hero-rings" viewBox="-100 -100 200 200">
          <circle r="58" /><circle r="74" class="ring-dash" /><circle r="92" />
          {Array.from({ length: 36 }, (_, i) => <path d="M0 -66V-62" transform={`rotate(${i * 10})`} />)}
        </svg>
        <div class="hero-window-stars">
          {[[18, 16, 0.9], [78, 12, 0.7], [30, 30, 0.5], [70, 28, 0.55], [12, 44, 0.45], [88, 46, 0.5]].map(([x, y, s]) => (
            <span style={`left:${x}%;top:${y}%`}><Star size={`${s}rem`} color="var(--c-cream)" /></span>
          ))}
        </div>
        <div class="hero-sun"><Sun /></div>
        <div class="hero-window-day"></div>
      </div>
      <Arch variant="portal" color="var(--c-gold)" lights={21} />
    </div>

    <span class="hero-crescent hero-crescent--r" data-intro><Moon lit={0.24} size="100%" rotate={18} /></span>
  </div>

  <div class="hero-daylight" aria-hidden="true"></div>

  <div class="hero-copy">
    <div class="hero-title" data-intro>
      <Wordmark as="h1" />
    </div>
    <p class="hero-payoff" data-intro="late">
      <span>Arte</span><Star size=".5em" /><span>Cultura</span><span class="hero-payoff-mid"><Star size=".5em" /></span><span>Simbolo</span><Star size=".5em" /><span>Immaginario</span>
    </p>
    <p class="hero-lede" data-intro="lede">
      Per tre giorni la Fabbrica del Vapore di Milano ospita un programma costruito intorno ai ventidue Arcani Maggiori.
    </p>
    <p class="hero-when" data-intro="late">Prima edizione <span aria-hidden="true">·</span> <span class="placeholder">date in arrivo</span></p>
    <div class="hero-cta" data-intro="late">
      <a class="btn btn--gold" href="#partecipa" data-magnetic>Richiedi il masterplan</a>
      <a class="btn btn--line" href={mailto("Incontro · Festival dei Tarocchi")} data-magnetic>Fissa un incontro</a>
    </div>
  </div>

  <div class="hero-flora" data-intro="late">
    <Flora seed={1} stems={[["felce", 40, 200, -16, -10], ["cosmo", 100, 260, 12], ["ramo", 150, 210, -6, -4], ["cosmo", 200, 190, 16, 8], ["lavanda", 250, 170, 6, 14]]} style="left:-1.5rem;bottom:-0.5rem;width:clamp(13.6rem, 24.0vw, 25.5rem)" />
    <Flora seed={2} flip stems={[["ramo", 60, 240, 18, 6], ["cosmo", 120, 270, -10], ["felce", 170, 200, 10, 6], ["secco", 220, 180, 8, 12], ["cosmo", 260, 160, -6, 16]]} style="right:-1.5rem;bottom:-0.5rem;width:clamp(13.6rem, 24.0vw, 25.5rem)" />
  </div>

  <button class="hero-skip" type="button" hidden>Salta l'introduzione</button>
  <TornEdge profile="moodboard-bottom" color="var(--c-night-deep)" class="hero-torn" />
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    padding: calc(var(--nav-h) + var(--s-3)) var(--gutter) var(--s-7);
    background: var(--c-night-deep);
    color: var(--c-cream);
    z-index: 1;
  }
  :global(.motion) .hero { overflow: clip; }
  :global(.motion) .hero-torn { display: none; }

  /* sky */
  .hero-sky { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .hero-star { position: absolute; display: block; line-height: 0; }
  :global(.motion) .hero-star :global(svg) { animation: twinkle 5s var(--d) ease-in-out infinite; }
  @keyframes twinkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .hero-dust {
    position: absolute; inset: -10% 0;
    background:
      radial-gradient(1px 1px at 12% 20%, var(--c-gold) 50%, transparent 51%),
      radial-gradient(1px 1px at 34% 64%, var(--c-cream) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 58% 28%, var(--c-terra) 50%, transparent 51%),
      radial-gradient(1px 1px at 81% 62%, var(--c-gold) 50%, transparent 51%),
      radial-gradient(1px 1px at 91% 34%, var(--c-gold) 50%, transparent 51%);
    background-size: 330px 250px;
    opacity: 0.7;
  }

  /* stage: arch between two crescents */
  .hero-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 5vw, 5rem);
    width: 100%;
  }
  .hero-crescent { width: clamp(2.2rem, 4.5vw, 4.2rem); margin-top: 18%; }
  .hero-portal {
    --h: min(44svh, 30rem);
    position: relative;
    flex: none;
    height: var(--h);
    width: calc(var(--h) * 200 / 260);
    transform-origin: 50% 56%; /* the centre of the sun */
  }
  .hero-portal :global(.arch-portal) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-portal::before {
    content: "";
    position: absolute;
    inset: -14% -42% -6%;
    background:
      radial-gradient(ellipse 42% 46% at 50% 62%, color-mix(in oklab, var(--c-gold) 38%, transparent), transparent 70%),
      radial-gradient(ellipse 60% 55% at 50% 55%, color-mix(in oklab, var(--c-magenta) 20%, transparent), transparent 72%);
    pointer-events: none;
  }
  :global(.motion) .hero-portal::before { animation: breathe 6s ease-in-out infinite; }
  @keyframes breathe { 50% { opacity: 0.65; } }
  /* the window matches the inner arch of the portal (x 30..170, top 30) */
  .hero-window {
    position: absolute;
    left: 15%; right: 15%; top: 11.5%; bottom: 0;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    /* the light comes from the sun: gold at the centre, night at the edges */
    background: radial-gradient(circle at 50% 50%,
      var(--c-gold) 0%, var(--c-terra) 26%, var(--c-magenta) 46%, var(--c-violet) 68%, var(--c-night) 88%, var(--c-night-deep) 100%);
  }
  /* sun, halo and rings share one centre: the middle of the window */
  .hero-halo {
    position: absolute;
    left: 50%; top: 50%;
    width: 120%; aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--c-cream) 55%, transparent) 0%, color-mix(in oklab, var(--c-gold) 35%, transparent) 30%, transparent 62%);
  }
  :global(.motion) .hero-halo { animation: halo 5s ease-in-out infinite; }
  @keyframes halo { 50% { scale: 1.08; opacity: 0.75; } }
  .hero-rings {
    position: absolute;
    left: 50%; top: 50%;
    width: 150%;
    translate: -50% -50%;
    overflow: visible;
    fill: none;
    stroke: var(--c-cream);
    stroke-width: 0.35;
    opacity: 0.45;
  }
  .hero-rings .ring-dash { stroke-dasharray: 1 3; }
  :global(.motion) .hero-rings { animation: sun-turn 240s linear infinite reverse; }
  .hero-window-stars { position: absolute; inset: 0; }
  .hero-window-stars span { position: absolute; line-height: 0; }
  :global(.motion) .hero-window-stars :global(svg) { animation: twinkle 4s ease-in-out infinite; }
  .hero-window-stars span:nth-child(2n) :global(svg) { animation-delay: -1.6s; }
  .hero-sun {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 150%;
    /* centre the disc of the sun (77, 76 in a 173 x 144 drawing), not its box */
    translate: -44.5% -52.8%;
  }
  .hero-sun :global(.sun-rays) { transform-box: view-box; }
  :global(.motion) .hero-sun :global(.sun-rays) { animation: sun-turn 140s linear infinite; }
  @keyframes sun-turn { to { rotate: 360deg; } }
  .hero-window-day { position: absolute; inset: 0; background: var(--c-cream); opacity: 0; }
  /* daylight: a cream arch that grows from the window to the whole screen */
  .hero-daylight { position: absolute; inset: 0; z-index: 3; background: var(--c-cream); visibility: hidden; pointer-events: none; }

  /* copy */
  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    width: 100%;
  }
  .hero-title { width: min(100%, 36rem, 62svh); margin-top: calc(-1 * clamp(1.5rem, 5svh, 3.5rem)); position: relative; }
  .hero-payoff {
    display: flex;
    color: var(--c-pink); flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 0.35em 0.9em;
    margin-top: var(--s-4);
    max-width: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.8rem, 0.65rem + 0.55vw, 1.15rem);
    letter-spacing: clamp(0.12em, 0.08em + 0.4vw, 0.28em);
    text-transform: uppercase;
  }
  .hero-lede { margin-top: var(--s-4); max-width: 36rem; font-size: var(--step-0); color: color-mix(in oklab, var(--c-cream) 88%, var(--c-pink)); }
  .hero-when { margin-top: var(--s-2); max-width: none; font-family: var(--font-display); font-style: italic; font-size: var(--step-1); color: var(--c-gold); }
  .hero-when .placeholder { font-style: normal; font-size: 0.8em; color: var(--c-cream); }
  .hero-cta { margin-top: var(--s-5); display: flex; gap: var(--s-4); flex-wrap: wrap; justify-content: center; }

  .hero-flora { position: absolute; inset: auto 0 0 0; height: 0; pointer-events: none; z-index: 2; }
  @media (max-width: 700px) { .hero-flora :global(.flora) { max-width: 34vw; } }
  .hero-skip {
    position: absolute;
    left: 50%; bottom: var(--s-5);
    translate: -50% 0;
    z-index: 5;
    background: none;
    border: 0;
    color: var(--c-pink);
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    padding: var(--s-2) var(--s-4);
  }

  /* intro: hidden only until the timeline has taken over (see Base.astro) */
  :global(.motion-pending) [data-intro]:not([data-intro="lede"]) { visibility: hidden; animation: failsafe 0s 4s forwards; }
  /* the lede is the largest text on a phone: it paints from the first frame
     (no wait for JS) and fades in slowly, arriving together with the title */
  :global(.motion-pending) .hero-lede, :global(.motion) .hero-lede { animation: lede-in 2.6s cubic-bezier(0.7, 0, 0.3, 1) both; }
  @keyframes lede-in { from { opacity: 0.03; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @keyframes failsafe { to { visibility: visible; } }

  /* mobile: a composition of its own, not a shrunk desktop */
  @media (max-width: 700px) {
    .hero { padding-bottom: var(--s-7); }
    .hero-stage { gap: var(--s-2); }
    .hero-portal { --h: min(46svh, 24rem); }
    .hero-crescent { width: 1.8rem; margin-top: 40%; }
    .hero-title { margin-top: calc(-1 * var(--s-6)); }
    .hero-lede { font-size: var(--fs-body); max-width: 21rem; }
    .hero-cta { width: 100%; flex-direction: column; gap: var(--s-3); }
    .hero-cta .btn { width: 100%; }
    /* two clean pairs: ARTE · CULTURA / SIMBOLO · IMMAGINARIO */
    .hero-payoff-mid { flex-basis: 100%; height: 0; overflow: hidden; }
  }
  @media (max-height: 760px) and (min-width: 701px) {
    .hero-portal { --h: 40svh; }
    .hero-lede { font-size: var(--fs-body); }
  }
</style>
