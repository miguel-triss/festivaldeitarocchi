---
// VI · I contenuti del Festival. A lighter, collage chapter after the walk:
// the programme on the moodboard's pink card, the Call for Artists as a notice
// on the wall (status: in arrivo), the Premio as a gold seal, the Collezione
// Permanente as a wall of arched frames that fills one edition at a time.
import Star from "./art/Star.astro";
import Tape from "./art/Tape.astro";
import Sun from "./art/Sun.astro";
import Flora from "./art/Flora.astro";
import { mailto } from "../data/sections";

const formats = [
  "conferenze e conversazioni", "tavole rotonde", "presentazioni editoriali", "podcast dal vivo", "performance",
  "workshop e laboratori", "masterclass", "visite e attività guidate", "progetti educational", "editoria e cultura visiva",
];
const fields = ["arte", "ricerca", "editoria", "divulgazione"];
const ring = "PREMIO FESTIVAL DEI TAROCCHI · ARTE · RICERCA · EDITORIA · DIVULGAZIONE · ";
const frames = ["I", "II", "III", "IV", "V"];
---

<section class="section contenuti" id="contenuti" data-scene="day" aria-labelledby="h-contenuti">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-num" aria-hidden="true">06</span>
      <h2 class="sec-title" id="h-contenuti">I contenuti del Festival</h2>
    </header>
    <p class="statement contenuti-statement" data-split>
      La produzione artistica è uno degli <em>elementi centrali</em> del Festival.
    </p>

    <div class="board">
      <!-- the programme: the pink card of the moodboard -->
      <article class="programma" data-rise>
        <Tape rotate={-8} width="5.5rem" style="top:-1rem;left:14%" />
        <h3 class="eyebrow">Il programma comprende</h3>
        <ul class="formats" role="list" data-formats>
          {formats.map((f) => <li><span class="formats-star" aria-hidden="true"><Star size=".6em" color="var(--c-magenta)" /></span>{f}</li>)}
        </ul>
        <p class="esperienze">
          Le attività a numero limitato e i format con una componente pratica o partecipativa costituiscono le{" "}
          <strong>Esperienze del Festival</strong>.
        </p>
        <Star size="1.6rem" color="var(--c-night)" class="programma-star" />
        <Flora seed={6} stems={[["lavanda", 70, 200, -6, -10], ["cosmo", 140, 250, 8]]} style="left:-6.5rem;bottom:-5.5rem;width:clamp(11.9rem, 17.6vw, 17.0rem)" />
      </article>

      <!-- the call: a notice on the wall -->
      <article class="call" data-rise="0.12">
        <Tape rotate={5} width="4.5rem" style="top:-0.9rem;right:16%" />
        <h3 class="call-title">Call for Artists</h3>
        <p>
          Una Call for Artists permette di individuare artisti chiamati a lavorare sui diversi Arcani e a produrre opere
          destinate alle Dimore.
        </p>
        <p class="call-stamp" data-call-stamp><span>In arrivo</span></p>
        <a class="btn btn--ink" href={mailto("Call for Artists · aggiornamenti")} data-magnetic>Ricevi gli aggiornamenti</a>
      </article>
    </div>

    <!-- the prize -->
    <article class="premio">
      <div class="seal" aria-hidden="true" data-seal>
        <svg class="seal-ring" viewBox="0 0 240 240">
          <defs><path id="seal-path" d="M120 120m-86 0a86 86 0 1 1 172 0a86 86 0 1 1 -172 0" /></defs>
          <path class="seal-edge" d={Array.from({ length: 36 }, (_, i) => {
            const a = (i / 36) * Math.PI * 2, b = ((i + 0.5) / 36) * Math.PI * 2;
            return `${i ? "L" : "M"}${(120 + 118 * Math.cos(a)).toFixed(1)} ${(120 + 118 * Math.sin(a)).toFixed(1)}L${(120 + 110 * Math.cos(b)).toFixed(1)} ${(120 + 110 * Math.sin(b)).toFixed(1)}`;
          }).join("") + "Z"} />
          <circle cx="120" cy="120" r="100" class="seal-band" />
          <text class="seal-text"><textPath href="#seal-path" textLength="538">{ring}</textPath></text>
          <circle cx="120" cy="120" r="70" class="seal-core" />
        </svg>
        <div class="seal-sun"><Sun /></div>
      </div>
      <div class="premio-text">
        <p class="eyebrow">Ogni edizione</p>
        <h3 class="premio-title" data-split>Il Premio Festival dei Tarocchi</h3>
        <p class="lead" data-rise>
          A una personalità o istituzione che abbia dato un contributo significativo alla conoscenza, allo studio o alla
          diffusione della cultura dei Tarocchi.
        </p>
        <p class="fields-label">attraverso</p>
        <ul class="fields" role="list" aria-label="Attraverso">
          {fields.map((f, i) => <li style={`--r:${[-3, 2, -2, 3][i]}deg`}>{f}</li>)}
        </ul>
      </div>
    </article>

    <!-- the permanent collection -->
    <article class="collezione">
      <div class="collezione-text">
        <p class="eyebrow">Separatamente dal Premio</p>
        <h3 class="collezione-title" data-split>La Collezione Permanente</h3>
        <p data-rise>
          La Direzione Artistica seleziona un'opera destinata alla Collezione Permanente del Festival. La Collezione cresce
          a ogni edizione e documenta le interpretazioni contemporanee degli Arcani prodotte nell'ambito del Festival.
        </p>
      </div>
      <ol class="wall" role="list" aria-label="La Collezione, un'opera per edizione" data-wall>
        {frames.map((n, i) => (
          <li class:list={["frame", { "is-first": i === 0 }]}>
            <svg viewBox="0 0 100 140" aria-hidden="true">
              <path class="frame-line" d="M6 136V50A44 44 0 0 1 94 50V136Z" />
              {i === 0 && <path class="frame-fill" d="M14 130V52A36 36 0 0 1 86 52V130Z" />}
              {i === 0 && <path class="frame-star" d="M50 66C51.4 86 55 90.6 72 92C55 93.4 51.4 98 50 118C48.6 98 45 93.4 28 92C45 90.6 48.6 86 50 66Z" />}
            </svg>
            <span class="frame-label">{i < 4 ? `${n} edizione` : "…"}</span>
          </li>
        ))}
      </ol>
    </article>
  </div>
</section>

<style>
  .contenuti { padding-block: var(--section-airy) var(--section-dense); }
  .contenuti-statement { max-width: 20ch; }

  .board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: var(--section-dense);
    align-items: start;
  }

  /* programme card */
  .programma {
    grid-column: 1 / span 6;
    position: relative;
    padding: var(--s-8) var(--s-7) var(--s-7);
    background: var(--c-rose-paper);
    rotate: -1.2deg;
    box-shadow: 0 20px 40px rgb(24 27 46 / 0.1);
  }
  .programma .eyebrow { color: var(--c-violet); margin-bottom: var(--s-5); }
  .formats { list-style: none; padding: 0; display: grid; gap: 0.15em; }
  .formats li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-h4);
    line-height: 1.3;
    color: var(--c-night-deep);
  }
  .formats-star { width: 0.7em; display: inline-grid; place-items: center; opacity: 0; transition: opacity var(--dur-fast); }
  .formats li:hover .formats-star { opacity: 1; }
  .esperienze { margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid color-mix(in oklab, var(--c-night) 22%, transparent); font-size: var(--fs-body); }
  .esperienze strong { font-family: var(--font-display); font-size: 1.3em; font-weight: 600; color: var(--c-violet); }
  .programma :global(.programma-star) { position: absolute; right: var(--s-6); bottom: var(--s-6); }

  /* call notice */
  .call {
    grid-column: 8 / -1;
    margin-top: var(--s-9);
    position: relative;
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding: var(--s-7) var(--s-6) var(--s-6);
    background:
      url("/textures/paper-grain.webp") 0 0 / 220px,
      var(--c-paper);
    background-blend-mode: soft-light;
    rotate: 1.4deg;
    box-shadow: 0 16px 34px rgb(24 27 46 / 0.12);
  }
  .call-title { font-size: var(--fs-h3); line-height: 1.05; }
  .call .btn { margin-top: var(--s-3); }
  .call-stamp {
    position: absolute;
    right: -1.2rem;
    top: -1.6rem;
    padding: 0.4em 0.8em;
    border: 3px double var(--c-magenta);
    background: var(--c-paper); /* its own paper: contrast holds wherever it lands */
    color: var(--c-magenta);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    rotate: -12deg;
    -webkit-mask: url("/textures/ink-mask.webp") 0 0 / 140px;
    mask: url("/textures/ink-mask.webp") 0 0 / 140px;
  }

  @media (max-width: 520px) { .call-stamp { position: static; order: 5; justify-self: end; margin-top: var(--s-2); rotate: -6deg; } }

  /* prize */
  .premio {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: center;
    margin-top: var(--section-dense);
  }
  .seal { position: relative; width: min(100%, 26rem); aspect-ratio: 1; margin-inline: auto; }
  .seal-ring { width: 100%; height: 100%; overflow: visible; }
  .seal-edge { fill: var(--c-gold); }
  .seal-band { fill: var(--c-night-deep); }
  .seal-core { fill: var(--c-gold); }
  .seal-text {
    fill: var(--c-cream);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.1em;
  }
  .seal-sun { position: absolute; inset: 22%; display: grid; place-items: center; --sun-gold: var(--c-cream); }
  .seal-sun :global(.sun) { width: 128%; max-width: none; }
  .premio-text .eyebrow { color: var(--c-magenta); }
  .premio-title { font-size: var(--fs-h3); line-height: 1.05; margin-block: var(--s-3) var(--s-5); max-width: 16ch; }
  .fields-label { margin-top: var(--s-5); font-family: var(--font-display); font-style: italic; font-size: var(--step-1); color: var(--fg-soft); }
  .fields { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .fields li {
    padding: 0.35em 1em 0.3em;
    border-radius: 999px 999px 0.3rem 0.3rem;
    background: var(--c-night-deep);
    color: var(--c-cream);
    font-family: var(--font-display);
    font-size: var(--step-1);
    rotate: var(--r);
  }

  /* collection wall */
  .collezione {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: var(--s-8);
    align-items: end;
    margin-top: var(--section-dense);
    padding: var(--s-8) var(--s-7);
    background: var(--c-rose-paper);
    border-radius: 0.5rem;
  }
  .collezione-title { font-size: var(--fs-h3); line-height: 1.05; margin-block: var(--s-3) var(--s-4); }
  .collezione-text .eyebrow { color: var(--c-violet); }
  .wall { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-5); align-items: end; }
  .frame { display: grid; gap: var(--s-3); justify-items: center; }
  .frame svg { width: 100%; overflow: visible; }
  .frame-line { fill: none; stroke: var(--c-night); stroke-width: 1.4; stroke-dasharray: 4 4; opacity: 0.55; }
  .is-first .frame-line { stroke: var(--c-gold); stroke-width: 3; stroke-dasharray: none; opacity: 1; }
  .frame-fill { fill: var(--c-night-deep); }
  .frame-star { fill: var(--c-gold); }
  .frame-label { font-family: var(--font-display); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-soft); }
  .is-first .frame-label { color: var(--c-night-deep); }

  @media (max-width: 900px) {
    .contenuti { padding-top: var(--section-dense); }
    .board { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
    .programma, .call { grid-column: 1 / -1; margin-top: 0; }
    .programma { padding: var(--s-7) var(--s-5) var(--s-6); }
    .premio, .collezione { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .seal { width: min(80%, 20rem); }
    .collezione { padding: var(--s-7) var(--s-5); }
    .wall { gap: var(--s-2); }
    .frame-label { font-size: 0.6rem; letter-spacing: 0.06em; }
  }
</style>
