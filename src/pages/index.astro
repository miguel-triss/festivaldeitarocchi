---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Passport from "../components/Passport.astro";
import Visione from "../components/Visione.astro";
import Tarocchi from "../components/Tarocchi.astro";
import Festival from "../components/Festival.astro";
import Fabbrica from "../components/Fabbrica.astro";
import Dimora from "../components/Dimora.astro";
import Contenuti from "../components/Contenuti.astro";
import Partner from "../components/Partner.astro";
import Rete from "../components/Rete.astro";
import ChiSiamo from "../components/ChiSiamo.astro";
import Notte from "../components/Notte.astro";
import Partecipa from "../components/Partecipa.astro";
import Footer from "../components/Footer.astro";
import Cursor from "../components/Cursor.astro";
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Visione />
    <Tarocchi />
    <Festival />
    <Fabbrica />
    <Dimora />
    <Contenuti />
    <Partner />
    <Rete />
    <ChiSiamo />
    <Notte />
    <Partecipa />
  </main>
  <Footer />
  <Passport />
  <Cursor />
</Base>

<script>
  import { startMotion } from "../scripts/motion";
  import { initHero } from "../scripts/hero";
  import { initReveals } from "../scripts/reveal";
  import { initProcession } from "../scripts/procession";
  import { initFestival } from "../scripts/festival";
  import { initEnfilade } from "../scripts/enfilade";
  import { initContenuti } from "../scripts/contenuti";
  import { initPartner } from "../scripts/partner";
  import { initFinale } from "../scripts/finale";
  startMotion();
  initProcession();
  initFestival();
  initEnfilade();
  initContenuti();
  initPartner();
  initFinale();
  initReveals();
  initHero();
</script>
