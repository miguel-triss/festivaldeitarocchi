---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Passport from "../components/Passport.astro";
import Visione from "../components/Visione.astro";
import Tarocchi from "../components/Tarocchi.astro";
import Cursor from "../components/Cursor.astro";
import { sections } from "../data/sections";
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    {/* Sections not yet built are empty stubs, built one at a time next. */}
    <Visione />
    <Tarocchi />
    {sections.slice(2).map((s) => (
      <section class="stub" id={s.id} data-scene={s.scene} aria-labelledby={`h-${s.id}`}>
        <div class="wrap">
          <p class="eyebrow">{s.numeral}</p>
          <h2 id={`h-${s.id}`}>{s.title}</h2>
          <p class="placeholder">[SEZIONE IN COSTRUZIONE]</p>
        </div>
      </section>
    ))}
  </main>
  <Passport />
  <Cursor />
</Base>

<script>
  import { startMotion } from "../scripts/motion";
  import { initHero } from "../scripts/hero";
  import { initReveals } from "../scripts/reveal";
  import { initProcession } from "../scripts/procession";
  startMotion();
  initProcession();
  initReveals();
  initHero();
</script>

<style>
  .stub {
    min-height: 90svh;
    padding-block: var(--section-dense);
    background: var(--bg);
    color: var(--fg);
  }
  .stub h2 { font-size: var(--step-5); margin-block: var(--s-3) var(--s-5); }
</style>
